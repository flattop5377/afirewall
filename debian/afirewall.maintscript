# CONFFILES THIS PACKAGE NO LONGER SHIPS, and the migration for hosts that already have them.
#
# Templates and lists moved to /usr/share/afirewall, so dpkg has to be told these are gone rather
# than left to keep them forever as orphans that shadow the shipped copies - afirewall reads /etc
# first, so a leftover would silently win over every future update.
#
# rm_conffile is the right tool and its behaviour is the reason ch7-U1 could be closed: an
# UNMODIFIED file is removed silently, and a MODIFIED one is moved aside to .dpkg-bak rather than
# kept active. So nobody's change is discarded and nobody's change goes on deciding what happens
# on upgrade. Safe, and not silent about it.
rm_conffile /etc/afirewall/templates/ipv4/base.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/baculadirector.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/baculafiledaemon.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/baculastoragedaemon.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/btc.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/dirport.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/http.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/https.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/orport.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/postgres.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/smtp.rules 20260816.2.0~
rm_conffile /etc/afirewall/templates/ipv4/inbound/ssh.rules 20260816.2.0~
