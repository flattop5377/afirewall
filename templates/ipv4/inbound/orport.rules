  #############################################################################
  #
  ## Tor ORPort Rules
  #
  # The relay port, which other relays and clients connect to. Split from DirPort because a
  # relay routinely runs one without the other: DirPort is deprecated in current Tor, and
  # relays that still publish directory data mostly serve it over the ORPort. A port nobody
  # needs open should not be opened by the same switch as one that is.
  #
  #############################################################################

  ##
  # ORPort connection rate limit
  #
  set orport_rate_limit {
    type ipv4_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # ORPort number of connections per source IP limit
  #
  set orport_connection_limit {
    type ipv4_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_ORPORT {
    ##
    # LIMIT POSTURE: enforce — the counterparty is anonymous, self-replacing, and does not
    # share its address with anyone who matters.
    #
    # The source is forgeable, so this is the third branch of ch1-3 rather than the easy one:
    # what makes enforcing safe is not that the address is trustworthy but that refusing it
    # costs nothing. Tor is redundant by design — a relay or client refused here reconnects,
    # or reaches the network by another path — so the collateral of a wrong drop is one
    # interchangeable peer for as long as the set holds it, unlike ssh, smtp or syslog where
    # the party refused is one the operator chose. A legitimate peer's rate sits far under these
    # limits, and what enforcing buys is that a single address cannot occupy the relay by
    # itself.
    #
    ct state new tcp dport 9001 update @orport_rate_limit { ip saddr limit rate over 50/minute } drop
    ct state new tcp dport 9001 add @orport_connection_limit { ip saddr ct count over 200 } drop
    ct state new,established tcp dport 9001 accept
  }

