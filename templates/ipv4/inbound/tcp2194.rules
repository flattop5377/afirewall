  #############################################################################
  #
  ## TCP 2194 Rules
  #
  #############################################################################

  ##
  # TCP 2914 connection rate limit
  #
  set tcp2194_rate_limit {
    type ipv4_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # SMTP number of connections per source IP limit
  #
  set tcp2194_connection_limit {
    type ipv4_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_TCP2194 {
    ##
    # LIMIT POSTURE: instrument — the authentication is what keeps strangers out, not this.
    #
    # The legitimate senders are a small known set and the port is TLS from the first byte, so
    # what refuses a stranger is the handshake and the MTA's relay rules. Enforcing would add
    # exactly one capability to the operator — anyone able to forge a known client's address can
    # defer that known client's mail — and no capability the authentication does not already
    # have. Counted and admitted.
    #
    ct state new tcp dport 2194 update @tcp2194_rate_limit { ip saddr limit rate 5/minute } continue
    ct state new tcp dport 2194 add @tcp2194_connection_limit { ip saddr ct count over 20 } continue
    ct state new,established tcp dport 2194 accept
  }

