  #############################################################################
  #
  ## SSH Rules
  #
  #############################################################################

  ##
  # SSH connection rate limit
  #   Ansible safe, since Ansible reuses connections when possible
  #
  # Meters documentat: https://wiki.nftables.org/wiki-nftables/index.php/Meters
  #
  set ssh_rate_limit {
    type ipv4_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # SSH number of connections per source IP limit
  #
  set ssh_connection_limit {
    type ipv4_addr
    size 65535
    flags dynamic
  }

  ##
  # This accepts IPv4 SSH traffix
  #
  chain ACCEPT_SSH {
    ##
    # LIMIT POSTURE: instrument — the admin path is the one service the operator cannot afford
    # to lose, and a limit that drops is a limit an attacker aims.
    #
    # A forged SYN carrying the controller's address costs nothing to send and spends the
    # controller's allowance for the 900s this set holds it, which locks administration out
    # of the host. Chapter 7 keeps a console fallback because ssh can be lost; it should not
    # be lost to our own rule. What actually refuses an ssh attacker here is fail2ban, pinned
    # to the nftables backend in a play, and it decides on evidence in the log rather
    # than on a source address anyone can write.
    #
      ##
      # Rate limit new connections per source ip address
      #
      ct state new tcp dport 22 update @ssh_rate_limit { ip saddr limit rate 5/minute } continue

      ##
      # Limit to 20 connections per source IP address
      #
      ct state new tcp dport 22 add @ssh_connection_limit { ip saddr ct count over 20 } continue

      ##
      # Allow SSH
      #   Destination port 22, protocol TCP
      #
      ct state new,established tcp dport 22 accept
  }
