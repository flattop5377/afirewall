  #############################################################################
  #
  ## TCP 8000 Rules — a check-in collector
  #
  # Every host pushes a heartbeat here and the absence of one is what raises the
  # alarm, so this port carries the signal that says the others are still working.
  # Inbound is wanted only on the collector; a host that merely checks in needs
  # the outbound half.
  #
  #############################################################################

  ##
  # TCP 8000 connection rate limit
  #
  set tcp8000_rate_limit {
    type ipv4_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # TCP 8000 number of connections per source IP limit
  #
  set tcp8000_connection_limit {
    type ipv4_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_TCP8000 {
    ct state new tcp dport 8000 update @tcp8000_rate_limit { ip saddr limit rate 5/minute } continue
    ct state new tcp dport 8000 add @tcp8000_connection_limit { ip saddr ct count over 20 } continue
    ct state new,established tcp dport 8000 accept
  }

