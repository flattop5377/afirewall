  #############################################################################
  #
  ## POSTGRES Rules
  #
  #############################################################################

  ##
  # POSTGRES rate limit
  #
  set postgres_rate_limit {
    type ipv4_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # POSTGRES connection limit
  #
  set postgres_connection_limit {
    type ipv4_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_POSTGRES {
    ##
    # LIMIT POSTURE: instrument — The client is a host the operator chose and cannot substitute,
    # so a limit that drops would hand anyone able to forge a SYN the power to cut a named
    # application off its database. The legitimate rate is bounded - a pooled client opens a
    # handful of connections and holds them - which makes enforcing available and still wrong,
    # for the same reason syslog's is.
    #
    ct state new tcp dport 5432 update @postgres_rate_limit { ip saddr limit rate 5/minute } continue
    ct state new tcp dport 5432 add @postgres_connection_limit { ip saddr ct count over 20 } continue
    ct state new,established tcp dport 5432 accept
  }
