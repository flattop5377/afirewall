  #############################################################################
  #
  ## TCP 8000 Rules — a check-in collector
  #
  # Where a fleet pushes a heartbeat to one collector and the ABSENCE of one raises
  # the alarm, this port carries the signal that says the others are still working.
  # Inbound is wanted only on the collector; a host that merely checks in needs the
  # outbound half.
  #
  #############################################################################

  ##
  # TCP 8000 connection rate limit
  #
  set tcp8000_rate_limit {
    type ipv6_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # TCP 8000 number of connections per source IP limit
  #
  set tcp8000_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_TCP8000 {
    ##
    # LIMIT POSTURE: instrument — enforcing would let a stranger manufacture alarms.
    #
    # Where absence of a heartbeat raises the alarm, a limit that drops turns a
    # forged flood into an alert for a host that is perfectly healthy. An alarm anybody can
    # induce is an alarm the operator learns to ignore, and losing the alerting system's
    # credibility costs more than accepting the flood does.
    #
    ct state new tcp dport 8000 update @tcp8000_rate_limit { ip6 saddr limit rate 5/minute } continue
    ct state new tcp dport 8000 add @tcp8000_connection_limit { ip6 saddr ct count over 20 } continue
    ct state new,established tcp dport 8000 accept
  }

