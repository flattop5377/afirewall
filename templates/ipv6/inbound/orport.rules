  #############################################################################
  #
  ## Tor ORPort Rules
  #
  # The relay port, which other relays and clients connect to. Split from DirPort because a
  # relay routinely runs one without the other: DirPort is deprecated in current Tor, and
  # relays that still publish directory data mostly serve it over the ORPort. A port nobody
  # needs open should not be opened by the same switch as one that is.
  #
  # The limits carry `over ... drop`. The `... continue` form used by the older templates
  # beside this one counts and then admits: when the limit fails to match, evaluation moves
  # to the next rule, and the next rule is an unconditional accept.
  #
  #############################################################################

  ##
  # ORPort connection rate limit
  #
  set orport_rate_limit {
    type ipv6_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # ORPort number of connections per source IP limit
  #
  set orport_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_ORPORT {
    ct state new tcp dport 9001 update @orport_rate_limit { ip6 saddr limit rate over 50/minute } drop
    ct state new tcp dport 9001 add @orport_connection_limit { ip6 saddr ct count over 200 } drop
    ct state new,established tcp dport 9001 accept
  }

