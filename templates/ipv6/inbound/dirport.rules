  #############################################################################
  #
  ## Tor DirPort Rules
  #
  # The directory port. Deprecated in current Tor - a relay that publishes directory data now
  # generally serves it over its ORPort instead - so this is here to be left off, and exists
  # separately so that leaving it off does not also close the ORPort.
  #
  # The limits carry `over ... drop`. The `... continue` form used by the older templates
  # beside this one counts and then admits: when the limit fails to match, evaluation moves
  # to the next rule, and the next rule is an unconditional accept.
  #
  #############################################################################

  ##
  # DirPort connection rate limit
  #
  set dirport_rate_limit {
    type ipv6_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # DirPort number of connections per source IP limit
  #
  set dirport_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_DIRPORT {
    ct state new tcp dport 9030 update @dirport_rate_limit { ip6 saddr limit rate over 50/minute } drop
    ct state new tcp dport 9030 add @dirport_connection_limit { ip6 saddr ct count over 200 } drop
    ct state new,established tcp dport 9030 accept
  }

