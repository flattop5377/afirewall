  #############################################################################
  #
  ## HTTPS Rules
  #
  #############################################################################

  ##
  # HTTPS connection rate limit
  #
  set https_rate_limit {
    type ipv6_addr
    size 65535
    timeout 90s
    flags dynamic
  }

  ##
  # HTTPS number of connections per source IP limit
  #
  set https_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_HTTPS {
    ##
    # LIMIT POSTURE: instrument — a per-source bound is a bound on a crowd, not on a client.
    #
    # A CGNAT range or an office behind one address shares this allowance, so a limit tight
    # enough to matter refuses legitimate readers before it refuses anything else. Nothing in
    # HTTPS bounds a legitimate rate from above either: one page load opens several
    # connections and a reader can reload. Counted and admitted.
    #
    ct state new tcp dport 443 update @https_rate_limit { ip6 saddr limit rate 50/minute } continue
    ct state new tcp dport 443 add @https_connection_limit { ip6 saddr ct count over 200 } continue
    ct state new,established tcp dport 443 accept
  }

