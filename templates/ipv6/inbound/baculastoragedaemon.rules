  #############################################################################
  #
  ## Baculs Storage Daemon Rules
  #
  #############################################################################

  ##
  # Bacula Storage Daemon connection rate limit
  #
  set baculastoragedaemon_rate_limit {
    type ipv6_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # Bacula Storage Daemon number of connections per source IP limit
  #
  set baculastoragedaemon_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_BACULASTORAGEDAEMON {
    ##
    # LIMIT POSTURE: instrument — recorded as what the rules do, not as an argued choice.
    #
    # NOTHING HAS EXERCISED THIS TEMPLATE. It ships with the package and has no traffic behind
    # it, so the posture below is inherited from the templates beside it rather than chosen. If
    # you deploy bacula, make the argument against its own behaviour before believing this.
    #
    ct state new tcp dport 9103 update @baculastoragedaemon_rate_limit { ip6 saddr limit rate 5/minute } continue
    ct state new tcp dport 9103 add @baculastoragedaemon_connection_limit { ip6 saddr ct count over 20 } continue
    ct state new,established tcp dport 9103 accept
  }

