  #############################################################################
  #
  ## UDP51821 Rules
  #
  #############################################################################

  ##
  # UDP51821 rate limit
  #
  set udp51821_rate_limit {
    type ipv6_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # UDP51821 connection limit
  #
  set udp51821_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_UDP51821 {
    ##
    # LIMIT POSTURE: instrument — The second WireGuard interface, whose port is its own
    # because 51820 already carries the operator tunnel. Instrument for the reason
    # inbound.wireguard does: WireGuard answers load with a cookie, which is a rate defence
    # that can still tell a real peer from a forged one, and this rule cannot. The peer here
    # is the tunnel peer, which the operator chose and cannot substitute, so a limit that drops
    # would let anyone able to forge a UDP source silence exactly the tunnel the rule exists
    # for.
    #
    ct state new udp dport 51821 update @udp51821_rate_limit { ip6 saddr limit rate 5/minute } continue
    ct state new udp dport 51821 add @udp51821_connection_limit { ip6 saddr ct count over 20 } continue
    ct state new,established udp dport 51821 accept
  }
