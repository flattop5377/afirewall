  #############################################################################
  # 
  ## SMTP Rules
  #
  #############################################################################

  ##
  # SMTP connection rate limit
  #
  set smtp_rate_limit {
    type ipv6_addr
    size 65535
    timeout 900s
    flags dynamic
  }

  ##
  # SMTP number of connections per source IP limit
  #
  set smtp_connection_limit {
    type ipv6_addr
    size 65535
    flags dynamic
  }


  chain ACCEPT_SMTP {
    ##
    # LIMIT POSTURE: instrument — the collateral is a named correspondent, and it is aimable.
    #
    # Enforcing would hand anyone able to forge a SYN the ability to defer mail from one
    # chosen sender for the 900s this set holds them. SMTP's own retry makes a drop
    # recoverable rather than fatal, which is the honest argument for enforcing here — but a
    # large sender's legitimate burst is not bounded below 5/minute, so the rule would refuse
    # real mail before it refused abuse. Counted and admitted.
    #
    ct state new tcp dport 25 update @smtp_rate_limit { ip6 saddr limit rate 5/minute } continue
    ct state new tcp dport 25 add @smtp_connection_limit { ip6 saddr ct count over 20 } continue
    ct state new,established tcp dport 25 accept
  }
