##
# REPLACE THIS PACKAGE'S TABLES ATOMICALLY, AND DO IT FIRST.
#
# `table X` creates it when it is absent and does nothing when it is not; `delete table X` then
# removes whatever was there. Together they mean this file always starts from nothing of ours and
# says so to `nft -c`, which is the whole point: validation runs against the kernel as it IS, so
# without this a chain that changed its hook or priority fails to validate against the copy of
# itself already loaded.
#
# THAT IS NOT HYPOTHETICAL, IT SHIPPED. 20260817.0.0 moved FRAGMENTS from `raw` to -450, and
# upgrading a host to it produced `Chain "FRAGMENTS" already exists in table ip
# 'a-firewall-inbound-ipv4' with different declaration` - so `regenerate` refused, correctly left
# the old firewall running, and the host sat with a new package and its predecessor's rules. Every
# host upgrading across that change would have done the same.
#
# ALL THREE TABLES, INCLUDING THE FORWARD ONE THIS RENDER MAY NOT DECLARE. Naming it here deletes
# a stale one left by a configuration that used to forward something and no longer does, which
# nothing else removes short of `afirewall stop`.
table ip6 a-firewall-inbound-ipv6
delete table ip6 a-firewall-inbound-ipv6
table ip6 a-firewall-forward-ipv6
delete table ip6 a-firewall-forward-ipv6
table ip6 a-firewall-outbound-ipv6
delete table ip6 a-firewall-outbound-ipv6

##
# IPV6 Rules.  These match the IPV4 rules
#
#
table ip6 a-firewall-inbound-ipv6 {

{% for s in services.inbound %}{% if s.include %}{% include s.include %}{% else %}{{ s.body }}{% endif %}{% endfor %}


  #############################################################################
  #
  ## DEFAULT rules
  #
  # Drop everything
  #
  #############################################################################

  ##
  # Drop all traffic that hasn't been accepted by priority 10 filters
  #
  chain DROP_BY_DEFAULT {
    type filter hook input priority 20; policy drop;

{% for s in services.inbound %}{% for j in s.jumps %}    {{ j }}
{% endfor %}{% endfor %}

    # NO `ct state established` HERE, BECAUSE A DHCP REPLY IS NOT RELIABLY A CONNTRACK REPLY.
    # A client that broadcasts or multicasts its request is answered from the server's own unicast
    # address, so the tuples do not match, the reply arrives INVALID or NEW, and a rule asking for
    # ESTABLISHED never fires. The reply then dies on the chain policy without touching a counter.
    #
    # DHCP IS ALSO THE ONE SERVICE WHOSE INBOUND HALF IS A REAL RULE. Everywhere else this line is
    # a conntrack reply path; here it has to be an accept in its own right, and one flag still opens
    # both - splitting it would make enabling half of it a way to lose an address quietly.
    #
    # MEASURED, AND THE TWO FAMILIES DISAGREED. IPv6: firewall up, a ten-minute lease counted 600
    # down to 25 and never renewed, and a forced reconfigure lost the address outright. IPv4:
    # renewed AND fully re-acquired through the same firewall, because networkd unicasts to a server
    # it already knows and the tuple matches. So IPv4 was never broken - it works by the CLIENT'S
    # choice of unicast rather than by anything this rule guarantees, and a firewall that depends on
    # which destination a client picks works until the client changes.
{% for s in services.outbound %}{% for r in s.replies %}    {{ r }}
{% endfor %}{% endfor %}

    meta l4proto ipv6-icmp jump VALID_ICMP

  }

  #############################################################################
  #
  ## ICMPv6 Rules
  #
  #############################################################################

  ##
  # ICMPv6 rate limit per source
  #
  set icmp_rate_limit {
    type ipv6_addr
    timeout 60s
    flags dynamic
  }

  ##
  # Only allow valid ICMPv6 inbound traffic.
  #   Drop all traffic except what's specifically allowed
  #
  # ICMPv6 is not optional the way ICMPv4 is. Neighbour discovery IS address resolution, so
  # filtering it does not harden the host, it disconnects it; and packet-too-big is the only
  # path-MTU mechanism IPv6 has, because routers on the path never fragment. Both sit ahead
  # of the rate limit - a limit that sheds them turns a busy segment into an outage rather
  # than a slowdown.
  #
  # Sources:
  #   https://www.iana.org/assignments/icmpv6-parameters/icmpv6-parameters.xhtml
  #   RFC 4890: Recommendations for Filtering ICMPv6 Messages in Firewalls
  ##
  #
  # LIMIT POSTURE: enforce — and it enforces by FALLING THROUGH, which no other rule here
  # does.
  #
  # The limit below is a match condition rather than a counted-and-ignored one: over
  # 10/second the rule stops matching, nothing beneath it accepts that packet, and the chain
  # policy drops it. So these rules refuse excess without the word `drop` appearing
  # anywhere, and a reader who has learned the `continue` form beside them will read this
  # backwards.
  #
  # Enforced because ICMP carries no service: the collateral of a wrong drop is diagnostics
  # rather than a counterparty, so nothing here fails the replaceability test the service
  # templates apply. What it does cost is recorded as ch1-U3.
  #
  chain VALID_ICMP {
    icmpv6 type nd-neighbor-solicit accept
    icmpv6 type nd-neighbor-advert accept
    icmpv6 type nd-router-solicit accept
    icmpv6 type nd-router-advert accept
    icmpv6 type packet-too-big accept

    icmpv6 type destination-unreachable update @icmp_rate_limit { ip6 saddr limit rate 10/second } accept
    icmpv6 type time-exceeded update @icmp_rate_limit { ip6 saddr limit rate 10/second } accept
    icmpv6 type parameter-problem update @icmp_rate_limit { ip6 saddr limit rate 10/second } accept
    icmpv6 type echo-request update @icmp_rate_limit { ip6 saddr limit rate 10/second } accept
    icmpv6 type echo-reply update @icmp_rate_limit { ip6 saddr limit rate 10/second } accept
  }

  #############################################################################
  #
  ## Block Private Subnet Spoofing
  #
  #############################################################################

  #############################################################################
  #
  ## Traffic that arrived here but was never addressed here
  #
  # A drop for anything whose destination is not an address of this host, which ufw has carried for
  # years as `addrtype --dst-type LOCAL`. It reads NO FLAG and names NO INTERFACE, so it is one of
  # the protections that does not depend on the operator having correctly said which network is
  # untrusted.
  #
  # WHAT IT IS NOT is a substitute for the SPOOFING chain, and an earlier draft of chapter 6 said
  # otherwise. That chain asks whether a SOURCE could have arrived where it did; this asks whether
  # the packet was ever for us. Neither covers the other and neither compensates for the other being
  # misconfigured - they are two protections, not a protection and its fallback.
  #
  # COUNTED, because on a normal host the routing decision has already sent everything addressed
  # elsewhere to the forward hook, so this may never fire. `nft list counters` is what says whether
  # it earns its place here rather than an assumption either way.
  #
  #############################################################################

  counter NUMBER_OF_NOT_LOCAL_DROPPED {
  }

  chain NOT_LOCAL {
    type filter hook input priority raw; policy accept;

      fib daddr type { local, broadcast, multicast } accept
      counter name NUMBER_OF_NOT_LOCAL_DROPPED drop
  }

  # Count the number of packets dropped by the SPOOFING chain
  counter NUMBER_OF_SPOOFS_DROPPED {
  }

  ##
  # We should not receive any traffix from private subnets on a Public
  # interface
  #
  # Reference:
  #   https://www.iana.org/assignments/iana-ipv6-special-registry/iana-ipv6-special-registry.xhtml
  # `raw`, NOT `mangle`, and it was mangle from the genesis commit until 2026-08-17. ch1-9 claims
  # these chains run at priority raw, and for ipv6 that claim was simply false - mangle is -150,
  # behind conntrack at -200, so a forged source got a conntrack entry created for it before this
  # chain dropped it. The v4 template argues the priority explicitly and this one said "see the
  # ipv4 template for why" while using a different number.
  chain SPOOFING {
    type filter hook input priority raw; policy accept;

    ##
    # Qualified by the external device - see the ipv4 template for why.
    #
    # `ip6 saddr`, not `ip saddr`: this is an ip6 table, where the ipv4 selector is a parse
    # error and not a rule that quietly matches nothing. It survived as long as it did only
    # because it never rendered - there was no lists/spoofed_IPV6_networks.list and
    # get_spoofed_networks() opened one for IPv4 alone, so this loop emitted no rows at all
    # and ipv6 had no anti-spoofing while appearing to. Both are fixed. The list is chosen
    # from IANA's own "Globally Reachable" column, and names the two entries it leaves out -
    # link-local and unspecified - because dropping either breaks neighbour discovery.
{% for network in SPOOFED_NETWORKS %}    iifname {{ EXTERNAL_DEVICE }} ip6 saddr {{ network }} counter name NUMBER_OF_SPOOFS_DROPPED drop
{% endfor %}
  }

  # Count the number of packets dropped by the INVALID_FLAGS chain
  counter NUMBER_OF_INVALID_FLAGS_DROPPED {
  }

  #############################################################################
  #
  ## Invalid TCP Flag rules
  #
  #############################################################################

  ##
  # Accept all traffix except invalid traffix.
  #
  # Based on (it's insane that in 2024 it's necessary to currate the references that are so hard to find)
  #   apf-firewall: https://www.rfxn.com/projects/advanced-policy-firewall/
  #   blog: https://www.sobyte.net/post/2022-04/understanding-netfilter-and-iptables/:
  #   netfileter wiki: https://wiki.nftables.org/wiki-nftables/index.php/Netfilter_hooks
  #   message thread: https://git.netfilter.org/nftables/log/include/expression.h?id=4e0026dc8d8693aaf2caf8df6d657a116734e84e&showmsg=1
  #   netfilter (iptables 2.4) documentation: https://netfilter.org/documentation/HOWTO/packet-filtering-HOWTO-7.html
  #   netfiler quick reference: https://wiki.nftables.org/wiki-nftables/index.php/Quick_reference-nftables_in_10_minutes#Ct
  #   blog: https://andreafortuna.org/2019/05/08/iptables-a-simple-cheatsheet/
  chain INVALID_FLAGS {
    type filter hook input priority raw; policy accept;
      # Drop segments that have no TCP flags: https://www.rfc-editor.org/rfc/rfc9293.html
      # FLAGS  = 00000000
      # MASK   = 11111111
      # RESULT = 00000000
      tcp flags == 0x0 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have both FIN and SYN flags set
      # FLAGS  = 00000011
      # MASK   = 00000011
      # RESULT = 00000011
      tcp flags == 0x3 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have FIN, SYN, RST, ACK, URG flags set (REDUNDANT)
      # FLAGS  = 00110111
      # MASK   = 00110111
      # RESULT = 00110111
      # tcp flags == 0x37 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have URG, ACK, PSH, RST, SYN, FIN flags set (REDUNDANT)
      # FLAGS  = 00111111
      # MASK   = 00111111
      # RESULT = 00111111
      # tcp flags == 0x3F counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have all TCP flags set (REDUNDANT)
      # FLAGS  = 11111111
      # MASK   = 11111111
      # RESULT = 11111111
      # tcp flags == 0x255 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have both SYN and RST flags set
      # FLAGS  = 00000110
      # MASK   = 00000110
      # RESULT = 00000110
      tcp flags == 0x6 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have both FIN and RST flags set
      # FLAGS  = 00000101
      # MASK   = 00000101
      # RESULT = 00000101
      tcp flags == 0x5 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that only have FIN
      # FLAGS  = 00000001
      # MASK   = 11111111
      # RESULT = 00000001
      tcp flags == 0x1 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have FIN without ACK (REDUNDANT)
      # FLAGS  = 00000001
      # MASK   = 00010001
      # RESULT = 00000001
      # tcp flags fin / fin,ack counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have URG without ACK
      # FLAGS  = 00100000
      # MASK   = 00110000
      # RESULT = 00100000
      tcp flags urg / urg,ack counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have PSH without ACK
      # FLAGS  = 00001000
      # MASK   = 00011000
      # RESULT = 00001000
      tcp flags psh / psh,ack counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have FIN, PSH, and URG flags set
      # FLAGS  = 00101001
      # MASK   = 00101001
      # RESULT = 00101001
      tcp flags == 0x29 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop conntrack segments with INVALID state
      # https://wiki.nftables.org/wiki-nftables/index.php/Matching_connection_tracking_stateful_metainformation
      ct state invalid counter drop
  }

  # Count the number of fragmented packets dropped
  counter NUMBER_OF_FRAGMENTS_DROPPED {
  }

  ##
  # IPV6 FRAGMENTS ARE A THING, and this chain did not exist until 2026-08-17. What IPv6 removed
  # is fragmentation BY ROUTERS - RFC 8200 s4.5 leaves it to the source node alone, which is why
  # packet-too-big has to be admitted through VALID_ICMP above. A source that fragments still
  # puts a Fragment extension header on the wire and this host still receives it, so "routers
  # never fragment" is not a reason to have no chain here. ch1-9 named FRAGMENTS as one of four
  # and ipv6 had three; the drill looped over the other three and could not see it.
  #
  # If anything the v6 case is sharper than the v4 one. RFC 7112 exists because a first fragment
  # that does not carry the whole header chain hides the L4 ports in a later fragment, where no
  # port rule can match them - evasion by construction. RFC 5722 requires the WHOLE datagram be
  # discarded when fragments overlap. RFC 8900 is the general position.
  #
  # `frag frag-off != 0` and not `exthdr frag exists`, deliberately: RFC 6946 atomic fragments
  # carry a Fragment header with offset 0 and MF unset and MUST be handled as unfragmented, so
  # the blunt form would break conformance and take large DNSSEC answers with it. Offset is the
  # selector that separates them, and it gives exactly the v4 semantics next door.
  #
  # WHAT THIS DOES NOT DO is enforce RFC 7112's first-fragment rule. nftables cannot ask whether
  # a first fragment carried the complete header chain, so the evasion that motivates the RFC is
  # only partly closed here: the follow-on fragments die, the reassembly never completes, and a
  # first fragment on its own is still admitted to the service chains. Recorded as ch1-U12.
  #
  # Priority -450 for the same reason as v4 - see that template. `nf_defrag_ipv6` is loaded here
  # by nf_conntrack and hooks prerouting at -400, so anything at `raw` runs after reassembly and
  # never sees a fragment at all.
  chain FRAGMENTS {
    type filter hook prerouting priority -450;

      frag frag-off != 0 counter name NUMBER_OF_FRAGMENTS_DROPPED drop
  }

  # Count the number of packets with a source or destination port of 0
  counter NUMBER_OF_PORT_ZERO_SEGMENTS_DROPPED {
  }

  chain PORT_ZERO {
    type filter hook input priority raw;

      tcp dport 0 counter name NUMBER_OF_PORT_ZERO_SEGMENTS_DROPPED drop
      tcp sport 0 counter name NUMBER_OF_PORT_ZERO_SEGMENTS_DROPPED drop
      udp dport 0 counter name NUMBER_OF_PORT_ZERO_SEGMENTS_DROPPED drop
      udp sport 0 counter name NUMBER_OF_PORT_ZERO_SEGMENTS_DROPPED drop
  }
}

{% if services.forward %}
##
# THE CROSSING TABLE, AND IT EXISTS ONLY WHEN SOMETHING ASKS FOR IT (ch4-2, ch4-6).
#
# A host that declares no forwarded service emits nothing here at all, so every machine that
# forwards today - a container runtime publishing a port, a tunnel, a namespace nobody told this
# package about - keeps working exactly as it did. That is why the chain is conditional rather than
# shipped permissive and tightened later: there is no migration to run.
#
# AND WHY THE FIRST DECLARATION IS A CLIFF (ch4-9). The moment one forwarded service is enabled this
# chain appears at `policy drop`, and everything else this host was forwarding stops. There is no
# posture that avoids that and is still a firewall; what the package owes is that nobody crosses the
# line without being told.
#
table ip6 a-firewall-forward-ipv6 {

  chain DROP_BY_DEFAULT {
    type filter hook forward priority 20; policy drop;

{% for s in services.forward %}{% for c in s.crossing %}    {{ c }}
{% endfor %}{% endfor %}  }
}
{% endif %}

table ip6 a-firewall-outbound-ipv6 {

{% for s in services.outbound %}{% if s.include %}{% include s.include %}{% else %}{{ s.body }}{% endif %}{% endfor %}

  #############################################################################
  #
  ## Drop by default
  #
  # If the output traffic isn't specifically accpeted by priority 10 rules,
  # this rule will drop the traffic.  EXCEPT if the connection is established.
  #
  #############################################################################
  chain DROP_BY_DEFAULT {
    type filter hook output priority filter; policy drop;

{% for s in services.inbound %}{% for r in s.replies %}    {{ r }}
{% endfor %}{% endfor %}

{% for s in services.outbound %}{% for j in s.jumps %}    {{ j }}
{% endfor %}{% endfor %}

    meta l4proto ipv6-icmp jump VALID_ICMP

  }

  # Count the number of packets dropped by the INVALID_FLAGS chain
  counter NUMBER_OF_INVALID_FLAGS_DROPPED {
  }

  chain INVALID_FLAGS {
    type filter hook output priority filter;

      # Drop segments that have no TCP flags: https://www.rfc-editor.org/rfc/rfc9293.html
      # FLAGS  = 00000000
      # MASK   = 11111111
      # RESULT = 00000000
      tcp flags == 0x0 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have both FIN and SYN flags set
      # FLAGS  = 00000011
      # MASK   = 00000011
      # RESULT = 00000011
      tcp flags == 0x3 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have both SYN and RST flags set
      # FLAGS  = 00000110
      # MASK   = 00000110
      # RESULT = 00000110
      tcp flags == 0x6 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have both FIN and RST flags set
      # FLAGS  = 00000101
      # MASK   = 00000101
      # RESULT = 00000101
      tcp flags == 0x5 counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have FIN without ACK
      # FLAGS  = 00000001
      # MASK   = 00010001
      # RESULT = 00000001
      tcp flags fin / fin,ack counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have URG without ACK
      # FLAGS  = 00100000
      # MASK   = 00110000
      # RESULT = 00100000
      tcp flags urg / urg,ack counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop segments that have PSH without ACK
      # FLAGS  = 00001000
      # MASK   = 00011000
      # RESULT = 00001000
      tcp flags psh / psh,ack counter name NUMBER_OF_INVALID_FLAGS_DROPPED drop

      # Drop conntrack segments with INVALID state
      ct state invalid counter drop
  }

  #############################################################################
  #
  ## ICMP Rules
  #
  #############################################################################

  ##
  # ICMP rate limit per source
  #
  set icmp_rate_limit {
    type ipv6_addr
    timeout 60s
    flags dynamic
  }

  ##
  # Only allow valid ICMP inbound traffix.
  #   Drop all traffix except what's specifically allowed
  #
  # Sources:
  #   https://www.iana.org/assignments/icmp-parameters/icmp-parameters.xhtml
  ##
  #
  # LIMIT POSTURE: enforce — keyed on `ip daddr`, which is ours to choose, and enforcing by
  # FALLING THROUGH rather than by saying `drop`.
  #
  # Over 10/second the rule stops matching, nothing beneath it accepts, and the chain policy
  # drops. This is the first branch of ch1-3: the address the limit is keyed on is the one
  # this host picked, so there is no forged source to aim it with. Enforced freely.
  #
  chain VALID_ICMP {
    icmpv6 type nd-neighbor-solicit accept
    icmpv6 type nd-neighbor-advert accept
    icmpv6 type nd-router-solicit accept
    icmpv6 type nd-router-advert accept
    icmpv6 type packet-too-big accept

    icmpv6 type destination-unreachable update @icmp_rate_limit { ip6 daddr limit rate 10/second } accept
    icmpv6 type time-exceeded update @icmp_rate_limit { ip6 daddr limit rate 10/second } accept
    icmpv6 type parameter-problem update @icmp_rate_limit { ip6 daddr limit rate 10/second } accept
    icmpv6 type echo-request update @icmp_rate_limit { ip6 daddr limit rate 10/second } accept
    icmpv6 type echo-reply update @icmp_rate_limit { ip6 daddr limit rate 10/second } accept
  }

}
